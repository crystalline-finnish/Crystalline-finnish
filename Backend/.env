# Copy this file to .env and fill in real values.
# .env is loaded automatically by config.py -- never commit your actual .env.

# --- Core ---
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# --- Admin access ---
ADMIN_API_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=crystalline2026


# --- Database ---
# Leave unset to use local SQLite. Set to a real Postgres URL in production:
DATABASE_URL=mysql+pymysql://root:@localhost:3306/crystalline_db

# --- CORS ---
# Comma-separated list of origins allowed to call the API with cookies.
# Add your deployed React admin URL here once it's live.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Email notifications (optional) ---
# Leave SMTP_HOST unset to disable email notifications entirely.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
NOTIFY_FROM_EMAIL=noreply@crystalline.co.ke
NOTIFY_TO_EMAIL=staff@crystalline.co.ke

# --- WhatsApp notifications (optional) ---
# Uses Meta's WhatsApp Business Cloud API. Leave WHATSAPP_ACCESS_TOKEN
# unset to disable WhatsApp notifications entirely.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_NUMBER=254700000000
